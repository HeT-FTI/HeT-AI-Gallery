                </mxCell>
                <mxCell id="x_b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="O projection&lt;br&gt;+ residual" vertex="1">
