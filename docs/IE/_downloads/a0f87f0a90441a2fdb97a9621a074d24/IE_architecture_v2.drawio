                <mxCell id="x_b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="KV append + GQA&lt;br&gt;online softmax&lt;br&gt;causal len=pos" vertex="1">
