                </mxCell>
                <mxCell id="c_r4c" value="CNN registry 输出不变；LLM 每 kernel golden；resolve 只在 create；fallback 与 SIMD 结果在容差内" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="1074" y="404" width="526" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r5a" value="IE/tests/qwen3_tokenizer_ref.c + IE/src/llm/ie_sampler.c + clock() 超时&lt;br&gt;测试实现和产品能力混杂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="490" width="470" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r5b" value="可选 src/tokenizer/* 产品组件；generate 接 IeSamplerConfig；Port 提供 tick/cancel；默认模板随 IEM 资产" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="542" y="490" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r5c" value="中英文、special token、流式 UTF-8、固定 seed、EOS、maxSeq、取消；CNN_ONLY 不包含这些符号" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="1074" y="490" width="526" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r6a" value="IE/examples/Makefile + IE/tests/makefile + 多个 qwen3 demo makefile&lt;br&gt;源文件清单和验证入口分散" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="576" width="470" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r6b" value="module → backend/cpu/scalar/cnn；registry → backend/core；llm → decoder/families + cpu/*/llm&lt;br&gt;student_text 流程 → legacy；通用算子 → scalar/{x86,neon,rvv}/generic，create 期绑定 Generic ABI v1&lt;br&gt;统一 profile 与显式组件清单；size/map、无 malloc、ABI、26 例性能基线与指令证据门禁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="542" y="576" width="500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r6c" value="CNN_ONLY / LLM_ONLY / FULL × F32/W8/W4 × resident/stream；测试资产可下载或显式跳过，不静默伪通过" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="1074" y="576" width="526" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c_r1a" target="c_r1b">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c_r2a" target="c_r2b">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c_r3a" target="c_r3b">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c_r4a" target="c_r4b">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c_r5a" target="c_r5b">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c_r6a" target="c_r6b">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_note" value="重构顺序不可反：先建立兼容测试和统一 Memory/Model/Kernel 契约 → 再把现有 Qwen3 数学实现搬入组件 → 最后替换 public API 默认实现。不要先删 ie_qwen3.c，也不要先设计一个覆盖所有模型的大而全 IR。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="690" width="1560" height="66" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="v2-roadmap" name="8-阶段路线与质量门禁">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="r_title" value="实施路线 —— 每个阶段都交付可运行版本，CNN 回归与二进制体积是全流程硬门禁" style="text;html=1;fontSize=20;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="40" y="16" width="1560" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="r_p0" value="P0　基线与契约冻结&lt;br&gt;· 固化 CNN/LLM golden、map/size、性能基线&lt;br&gt;· 关闭 registry 在途收口与生产/demo 分离&lt;br&gt;· 明确 Model/Memory/Kernel ABI 和错误语义&lt;br&gt;&lt;b&gt;退出：现有测试全绿；缺失资产有显式获取或跳过策略&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="76" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="r_p1" value="P1　统一内存与模型底座&lt;br&gt;· MemoryReport + prefill/decode scratch 分档&lt;br&gt;· IEM 配置成为唯一事实来源&lt;br&gt;· Session 统一，旧 Qwen API 作为 adapter&lt;br&gt;· CNN_ONLY/LLM_ONLY/FULL 构建档位&lt;br&gt;&lt;b&gt;退出：query=布局=峰值；老模型兼容；CNN-only 零 LLM 符号&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="420" y="76" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="r_p2" value="P2　Decoder Plan 与内核收口&lt;br&gt;· 拆 ie_qwen3.c；引入 comp_llm_cpu&lt;br&gt;· LLM kernel ABI + CPU fallback + registry resolve&lt;br&gt;· 保留 chunked prefill 和现有 W8/W4 数值能力&lt;br&gt;· 通用 ie_llm 不再只是 Qwen typedef 转发&lt;br&gt;&lt;b&gt;退出：同 token/logits/KV 对拍；每层内核 golden；无热路径 probe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="800" y="76" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="r_p3" value="P3　产品化与性能发布&lt;br&gt;· 可选 C tokenizer / generate sampler / Port tick/cancel&lt;br&gt;· W4A16 优化，之后独立评估 W4A8&lt;br&gt;· SIMD/DSP、权重流送、NPU delegate 按收益逐项落地&lt;br&gt;· 完成质量、内存、体积、性能、长上下文与异常测试&lt;br&gt;&lt;b&gt;退出：MiniMind 文本端到端 + 目标板指标达标 + 全量回归&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1180" y="76" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="r_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="r_p0" target="r_p1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="r_p1" target="r_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="r_p2" target="r_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_gates" value="四类硬门禁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="324" width="760" height="414" as="geometry"/>
                </mxCell>
                <mxCell id="r_g1" value="正确性&lt;br&gt;CNN 老模型逐字节/输出一致；LLM 逐层 golden、greedy token 序列、KV 分段等价；固定 seed 采样可复现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="64" y="376" width="336" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="r_g2" value="质量&lt;br&gt;FP32 为参考分别评估 W8/W4/KV int8；困惑度与垂直任务准确率阈值由基线实测后冻结，不凭空指定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="424" y="376" width="352" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="r_g3" value="资源与鲁棒性&lt;br&gt;默认无 malloc；query/create 一致；区域 canary、32-bit、溢出、坏模型、OOM、IO 失败、cancel、reset、多 session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="64" y="544" width="336" height="158" as="geometry"/>
                </mxCell>
                <mxCell id="r_g4" value="性能与轻量化&lt;br&gt;CNN_ONLY 无 LLM 符号且体积不回退；TTFT/prefill/decode/带宽利用率入报告；热路径汇编和 map diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="424" y="544" width="352" height="158" as="geometry"/>
                </mxCell>
                <mxCell id="r_risks" value="关键风险与止损策略" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="832" y="324" width="768" height="414" as="geometry"/>
                </mxCell>
                <mxCell id="r_r1" value="统一过度 → 运行时臃肿&lt;br&gt;止损：只统一底座，保留双执行器；禁止图 VM 和运行期模型结构识别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="856" y="376" width="720" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r_r2" value="W4 + 激活/KV 同时量化 → 精度难定位&lt;br&gt;止损：权重、激活、KV 三个开关独立；先 W8A16，再 W4A16，最后 W4A8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="856" y="454" width="720" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r_r3" value="格式与 ABI 同步改动 → 老模型破坏&lt;br&gt;止损：旧 loader 不动；新增 section；版本/feature 门；兼容矩阵先于实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="856" y="532" width="720" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r_r4" value="流送或 NPU 看似高级但实测更慢&lt;br&gt;止损：CPU 全驻永远是基线；以端到端 tok/s、TTFT、能耗和内存净收益决定是否默认启用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="856" y="610" width="720" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r_scope" value="首版明确不做：训练 / 微调、云端服务、多用户连续批处理、投机解码、任意动态控制流、通用多模态、运行期 JIT。它们与 minimind 级本地垂直模型目标无关，避免侵蚀轻量化。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="780" width="1560" height="66" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>