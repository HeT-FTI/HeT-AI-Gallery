                </mxCell>
                <mxCell id="c_r4a" value="IE/src/backend/registry/* + ie_qwen3.c 静态数学函数&lt;br&gt;LLM 未注册，CNN ABI 表达能力有限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
