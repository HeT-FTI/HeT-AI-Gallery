                    <mxGeometry x="40" y="232" width="470" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c_r2b" value="runtime/ie_memory_plan.c 单一布局函数&lt;br&gt;session 只持有区域；decoder 提供 prefill/decode scratch profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
