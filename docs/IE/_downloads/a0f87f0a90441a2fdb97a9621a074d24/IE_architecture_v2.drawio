                <mxCell id="a_gap1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="① 双运行时割裂&lt;br&gt;CNN 走 IeGraph；Qwen3 在 ie_qwen3.c 内手写完整网络，未复用 registry / delegate / 统一 session" vertex="1">
                    <mxGeometry height="76" width="452" x="576" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="a_gap2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="② 模型契约重复&lt;br&gt;Strata/Magma 与 IEM4 并存；形状、dtype、权重布局、内存需求部分由调用方手工重复填写" vertex="1">
                    <mxGeometry height="76" width="452" x="576" y="216" as="geometry"/>
                </mxCell>
                <mxCell id="a_gap3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="③ 工作区随 maxSeq 预分配&lt;br&gt;decode 与 prefill 未分档；x/q/gate 等 11 块都按 maxSeq 分配，长上下文造成非 KV 内存浪费" vertex="1">
                    <mxGeometry height="76" width="452" x="576" y="308" as="geometry"/>
                </mxCell>
                <mxCell id="a_gap4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="④ 产品化缺口&lt;br&gt;tokenizer 仍是测试参考实现；Qwen generate 仍 greedy；clock() 超时非平台抽象；head_dim/rope 有固定数组假设" vertex="1">
                    <mxGeometry height="76" width="452" x="576" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="a_gap5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="⑤ 性能与构建门禁不足&lt;br&gt;标量 W4 每元素反量化；无统一 LLM 组件；IE_ENABLE_LLM 尚未形成 CNN-only 零增长门禁；CI 依赖本地模型资产" vertex="1">
                    <mxGeometry height="76" width="452" x="576" y="492" as="geometry"/>
                </mxCell>
                <mxCell id="a_decision" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="核心架构决策：统一底座，不强行统一执行形态" vertex="1">
                    <mxGeometry height="530" width="500" x="1084" y="72" as="geometry"/>
                </mxCell>
                <mxCell id="a_dec1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="共享底座&lt;br&gt;IEM 模型视图｜IePool / MemoryPlan｜Tensor / Weight View&lt;br&gt;Kernel Registry｜Session 生命周期｜日志 / 计时 / IO 端口" vertex="1">
                    <mxGeometry height="100" width="452" x="1108" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="a_dec2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="执行前端 A：Static Graph Plan&lt;br&gt;服务 CNN / 传统网络；保持离线物理 tensor 与顺序层执行，不引入动态图 VM" vertex="1">
                    <mxGeometry height="76" width="452" x="1108" y="244" as="geometry"/>
                </mxCell>
                <mxCell id="a_dec3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="执行前端 B：Decoder Block Plan&lt;br&gt;服务 LLM；block 模板 + 每层权重描述 + KV 游标；prefill chunk 与 decode 两条专用热路径" vertex="1">
                    <mxGeometry height="82" width="452" x="1108" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="a_dec4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="编译期产品档位&lt;br&gt;CNN_ONLY：无 LLM 代码 / 数据 / 内存开销&lt;br&gt;LLM_ONLY：不链入 CNN 算子&lt;br&gt;FULL：共享同一份核心与内核 ABI" vertex="1">
                    <mxGeometry height="100" width="452" x="1108" y="442" as="geometry"/>
                </mxCell>
                <mxCell id="a_rule" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" value="永不妥协的边界：运行时无 malloc / 无图分析 / 无 JIT / 无 Python 依赖；复杂融合、量化、布局选择、内存规划全部离线完成。采样属于生成驱动，不塞进底层计算图。" vertex="1">
                    <mxGeometry height="70" width="1544" x="40" y="646" as="geometry"/>
                </mxCell>
                <mxCell id="a_verify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" value="远程 CI：完整主机回归、ASan/UBSan、TFLite 76,800 元素对拍及六档质量门禁通过；RV32 / Cortex-A7 / RVV QEMU 共 43 项、Renode M55/MVE 4 项功能模拟纳入 CI。Generic、LLM、CNN 单核、两档 MobileNetV3 NEON 整图及 Strata v3 变长计数已做独立参考差分或端到端验证；26 例性能基线、37 项指令证据和 Generic/LLM/CNN Renode 指令基线纳入 CI。NPU、真实 DMA 和目标板性能/功耗仍需实机验收。" vertex="1">
                    <mxGeometry height="68" width="1544" x="40" y="740" as="geometry"/>
                </mxCell>
