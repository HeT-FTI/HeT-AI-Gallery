                <mxCell id="x_b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="RMSNorm + SwiGLU&lt;br&gt;gate/up/down&lt;br&gt;+ residual" vertex="1">
                    <mxGeometry height="92" width="126" x="1010" y="312" as="geometry"/>
