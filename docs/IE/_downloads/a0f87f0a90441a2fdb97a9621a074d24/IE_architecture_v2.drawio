                <mxCell id="x_repeat" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;strokeColor=none;fillColor=none;" value="for layer = 0..L-1：读 layer_desc[l] → 调同一组已绑定 kernels；支持权重全驻或按层流送" vertex="1">
                    <mxGeometry height="34" width="916" x="220" y="452" as="geometry"/>
                </mxCell>
                <mxCell id="x_final" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="final RMSNorm → LM Head（tied embedding 可共享）→ logits[vocab] → sampler（生成层，不是图算子）" vertex="1">
                    <mxGeometry height="48" width="916" x="220" y="506" as="geometry"/>
                </mxCell>
                <mxCell id="x_pre" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="PREFILL 热路径&lt;br&gt;· 输入 n = min(prefillChunk, remaining)&lt;br&gt;· 多 token GEMM，提高计算强度&lt;br&gt;· 工作区按 chunk 而非 maxSeq&lt;br&gt;· causal 边界 base=pos，写 KV 后 attend&lt;br&gt;· 最后一次输出只保留 last-token logits" vertex="1">
                    <mxGeometry height="190" width="490" x="40" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="x_dec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="DECODE 热路径&lt;br&gt;· n=1，矩阵乘转 GEMV&lt;br&gt;· 权重通常每 token 只读一次，带宽优先&lt;br&gt;· Q4 解包 / 反量化内联，不生成完整 FP 权重&lt;br&gt;· KV 布局面向连续访问，量化 scale 同预算&lt;br&gt;· 预绑定函数指针，无逐层 probe / 字符串查找" vertex="1">
                    <mxGeometry height="190" width="500" x="566" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="x_state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="会话状态边界&lt;br&gt;跨步：KV、position、RNG、可选 history&lt;br&gt;跨层：当前 x / 临时激活（可复用）&lt;br&gt;模型：常量只读，可多 session 共享&lt;br&gt;失败：上下文耗尽 / IO / cancel 返回明确状态；禁止半推进 pos" vertex="1">
                    <mxGeometry height="190" width="498" x="1102" y="620" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="v2-memory" name="4-内存与权重IO架构">
        <mxGraphModel dx="1600" dy="1141" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="m_title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;strokeColor=none;fillColor=none;" value="内存与权重 IO —— 容量可查询、所有权清晰、decode 与 prefill 分开规划" vertex="1">
                    <mxGeometry height="36" width="1560" x="40" y="16" as="geometry"/>
                </mxCell>
                <mxCell id="m_pool" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="调用方连续内存 / 静态内存（IePool 只借不拥有）" vertex="1">
                    <mxGeometry height="470" width="960" x="40" y="72" as="geometry"/>
                </mxCell>
                <mxCell id="m_meta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="META&lt;br&gt;session / tensor view&lt;br&gt;kernel plan / layer desc&lt;br&gt;create 期固定" vertex="1">
                    <mxGeometry height="130" width="200" x="64" y="126" as="geometry"/>
                </mxCell>
                <mxCell id="m_act" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="ACT / SCRATCH&lt;br&gt;decode 与 prefill 两份预算取最大值&lt;br&gt;按 prefillChunk 缩放，不按 maxSeq&lt;br&gt;生命周期复用 + mark/rewind&lt;br&gt;fast scratch 可选" vertex="1">
                    <mxGeometry height="130" width="320" x="288" y="126" as="geometry"/>
                </mxCell>
                <mxCell id="m_kv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="KV + QUANT META&lt;br&gt;[L][2][Hkv][S][D] 连续缓存&lt;br&gt;append-only；pos 是逻辑长度&lt;br&gt;int8 scale / zero point 同域计账&lt;br&gt;reset 只复位游标" vertex="1">
                    <mxGeometry height="130" width="344" x="632" y="126" as="geometry"/>
                </mxCell>
                <mxCell id="m_io" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="IO / TOKEN / SAMPLER&lt;br&gt;ids / logits / top-k 工作区 / history&lt;br&gt;logits 可零拷贝暴露&lt;br&gt;tokenizer 单独可裁剪" vertex="1">
                    <mxGeometry height="110" width="350" x="64" y="286" as="geometry"/>
                </mxCell>
                <mxCell id="m_stream" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="可选 STREAM WINDOW&lt;br&gt;maxLayerBytes × 2（ping-pong）&lt;br&gt;DMA / reader 回调填充&lt;br&gt;未启用时预算为 0" vertex="1">
                    <mxGeometry height="110" width="300" x="438" y="286" as="geometry"/>
                </mxCell>
                <mxCell id="m_guard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="统一 MemoryReport&lt;br&gt;total = align(META)+align(ACT)+align(KV)+align(KV_META)+align(IO)+align(STREAM)&lt;br&gt;query_memory 与 create 使用同一个 layout 函数；含对齐损耗、溢出检查、区域峰值和 canary 测试" vertex="1">
                    <mxGeometry height="88" width="912" x="64" y="426" as="geometry"/>
                </mxCell>
                <mxCell id="m_weight" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="权重域（不计入可写 pool，除非选择复制）" vertex="1">
                    <mxGeometry height="470" width="568" x="1032" y="72" as="geometry"/>
                </mxCell>
                <mxCell id="m_resident" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="模式 A：全驻 / XIP（默认）&lt;br&gt;IEM blob 位于 Flash / ROM / 映射内存&lt;br&gt;权重只读、零拷贝、跨 session 共享&lt;br&gt;适合 RAM 紧张但可直接寻址存储足够的设备" vertex="1">
                    <mxGeometry height="116" width="520" x="1056" y="126" as="geometry"/>
                </mxCell>
                <mxCell id="m_streamw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="模式 B：按层流送（存储受限 / 慢内存）&lt;br&gt;common 常驻 + layer 双窗口；计算 L 时预取 L+1&lt;br&gt;reader / DMA 由 Port 提供；失败不推进 layer / pos&lt;br&gt;不得默认承诺提速，需用带宽与 DMA 重叠实测决定" vertex="1">
                    <mxGeometry height="128" width="520" x="1056" y="266" as="geometry"/>
                </mxCell>
                <mxCell id="m_layout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" value="共同约束：权重 descriptor 记录 offset / bytes / dtype / group / layout；packer 保证对齐与 CRC；运行时禁止按名称查权重、禁止把整层反量化到临时 FP 缓冲。" vertex="1">
                    <mxGeometry height="96" width="520" x="1056" y="418" as="geometry"/>
                </mxCell>
                <mxCell id="m_formula" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="MiniMind-3（当前 manifest：L=8，H=768，Hkv=4，D=96，P=63,912,192，V=6400）&lt;br&gt;KV bytes = 2 × L × Hkv × maxSeq × D × kvElemSize；int8@1024 = 6.00 MiB；当前 FP32/token scale 另需 0.25 MiB，总计约 6.25 MiB。&lt;br&gt;W4_g64 + FP16 scale 估算 = ceil(P/2) + ceil(P/64)×2 = 32.38 MiB（未含容器、tokenizer、对齐）；W8 权重约 60.96 MiB。&lt;br&gt;ACTIVATION = f(prefillChunk, H, heads, intermediate, dtype)，不再含 maxSeq；decode 固定 n=1。" vertex="1">
                    <mxGeometry height="190" width="960" x="40" y="584" as="geometry"/>
                </mxCell>
                <mxCell id="m_budget" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="预算示例（目标估算，非实测承诺）&lt;br&gt;W4 全驻 + int8 KV@1024：只读权重约 32.38 MiB；可写内存约 6.25 MiB KV + prefill scratch + IO/META。&lt;br&gt;若 chunk=16，目标把 scratch 控制在约 1 MiB 量级；chunk=64 时须按实际 MemoryReport 重新预算，不能沿用 decode 的 &lt;1 MiB 结论。&lt;br&gt;流送模式的 pool 以 2×maxLayerBytes 替代整层权重驻留，但 common / tied embedding 是否常驻必须单列。&lt;br&gt;验收以 query_memory == 实际布局 == 峰值报告为准，并保留 64B 对齐与平台差异。" vertex="1">
                    <mxGeometry height="190" width="568" x="1032" y="584" as="geometry"/>
                </mxCell>
                <mxCell id="m_non" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="明确不做：运行期 malloc / realloc；按最大上下文分配所有激活；每层复制完整权重；隐式全局 KV；以“约 32MB 权重”代替包含 KV scale、tokenizer、对齐和 scratch 的总拥有成本。" vertex="1">
                    <mxGeometry height="62" width="1560" x="40" y="814" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="v2-format" name="5-模型容器与离线编译契约">
        <mxGraphModel dx="1600" dy="1141" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="f_title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;strokeColor=none;fillColor=none;" value="模型容器与离线编译契约 —— 以当前 IEM4 为事实起点，下一版只增 section，不回退设计 v3" vertex="1">
                    <mxGeometry height="36" width="1560" x="40" y="16" as="geometry"/>
                </mxCell>
                <mxCell id="f_old" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="兼容输入" vertex="1">
                    <mxGeometry height="280" width="400" x="40" y="72" as="geometry"/>
                </mxCell>
                <mxCell id="f_old1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="Legacy Strata / Magma v1&lt;br&gt;stock CPU loader 保持可读&lt;br&gt;registry 无预留槽位时明确拒绝或走 stock" vertex="1">
                    <mxGeometry height="82" width="352" x="64" y="126" as="geometry"/>
                </mxCell>
                <mxCell id="f_old2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="Strata / Magma v2&lt;br&gt;现有 CNN + registry 路径&lt;br&gt;字节布局不在 LLM 重构中改写" vertex="1">
                    <mxGeometry height="88" width="352" x="64" y="228" as="geometry"/>
                </mxCell>
                <mxCell id="f_cur" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="当前 IEM4（已存在）&lt;br&gt;INFO / TENSORS / WEIGHTS / QUANT / LAYERS&lt;br&gt;TOKENIZER / GENERATION / SIGNATURE / STATE&lt;br&gt;64B align、section CRC、只读 view" vertex="1">
                    <mxGeometry height="180" width="380" x="480" y="102" as="geometry"/>
                </mxCell>
                <mxCell id="f_next" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="下一版 IEM（建议 v5，仅在有契约测试后引入）&lt;br&gt;新增 PLAN：kind=STATIC_GRAPH / DECODER_BLOCK，kernel/layout 绑定信息&lt;br&gt;新增 MEMORY：decode/prefill/stream 各区域需求与对齐&lt;br&gt;新增 CAPABILITY：dtype、GQA、RoPE、quant、所需算子/feature bits&lt;br&gt;扩展 LAYERS：统一 weight descriptor，消除调用方手工 commonBytes/layerBytes 重复&lt;br&gt;CNN Strata v3：计数字段逃逸式变长编码，冷路径展开，255+ 通道/分类头&lt;br&gt;旧 section type 保持；未知必需 section 明确 NO_SUPPORT" vertex="1">
                    <mxGeometry height="230" width="700" x="900" y="82" as="geometry"/>
                </mxCell>
                <mxCell id="f_e1" edge="1" parent="1" source="f_old" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="f_cur" value="统一只读视图">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_e2" edge="1" parent="1" source="f_cur" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" target="f_next" value="增量演进">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
