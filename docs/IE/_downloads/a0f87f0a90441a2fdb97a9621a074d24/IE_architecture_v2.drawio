                    <mxGeometry height="58" width="452" x="596" y="498" as="geometry"/>
                </mxCell>
                <mxCell id="k_hw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="硬件加速与数值契约" vertex="1">
                    <mxGeometry height="350" width="496" x="1104" y="232" as="geometry"/>
                </mxCell>
                <mxCell id="k_h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="机制 A：同构 kernel 替换&lt;br&gt;NEON/RVV/MVE：LLM FP32/W8/W4A16 Linear + 全类型 KV Attention；SIMD 共用 online-softmax&lt;br&gt;NEON/MVE CNN：int8 Conv2D/DWConv2D/静态与动态 Dense；两者另含 int8/FP32 MaxPool2D、int8/FP32 GAP 与 FP32 ReLU/ReLU6/LeakyReLU/HardSwish&lt;br&gt;canonical 布局，registry 冷路径绑定；独立 scalar golden / fallback；CNN RVV 与 xbs1 搁置" vertex="1">
                    <mxGeometry height="76" width="448" x="1128" y="286" as="geometry"/>
                </mxCell>
                <mxCell id="k_h2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="机制 B：子图 delegate&lt;br&gt;离线 blob / IEM DELEGATE 优先，冷路径校验并绑定&lt;br&gt;热路径仅 invoke；无计划才 prepare；CPU 可回退" vertex="1">
                    <mxGeometry height="76" width="448" x="1128" y="364" as="geometry"/>
                </mxCell>
                <mxCell id="k_h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="机制 C：多布局权重&lt;br&gt;packer 按目标生成；不可移植布局带 capability&lt;br&gt;缺失时回 canonical，而非加载失败" vertex="1">
                    <mxGeometry height="76" width="448" x="1128" y="456" as="geometry"/>
                </mxCell>
                <mxCell id="k_perf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="性能纪律：decode 近似每 token 扫一遍权重，先用 effective_bandwidth / weight_bytes 推上限，再以 TTFT、prefill tok/s、decode tok/s、每 token 权重字节、cache 命中率、pool peak 验证。旧图“95%”“60%”只能作为目标假设，不能作为未测事实；目标平台达到有效带宽利用率 ≥60% 后再冻结优化。" vertex="1">
                    <mxGeometry height="78" width="1560" x="40" y="626" as="geometry"/>
                </mxCell>
                <mxCell id="k_abi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="ABI 演进：保留旧 opFunc 适配 CNN；新增支持 WeightView / TensorView / Scratch / KV 的 LLM kernel ABI，并递增 IE_KERNEL_ABI_VERSION。不要让 4D/8-bit tensor index 的旧描述硬塞所有 Transformer 语义；也不要复制一套只服务 Qwen 的 registry。" vertex="1">
                    <mxGeometry height="66" width="1560" x="40" y="736" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
