                </mxCell>
                <mxCell id="c_r2c" value="query/create 一致；pool 不足、未对齐、溢出、双 session、reset 后重复运行全部通过" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
